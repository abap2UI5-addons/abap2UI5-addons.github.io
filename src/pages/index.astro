---
/* The overview: every addon, in groups, one tile each. A tile opens the
 * addon's page on this site, or its own site where it has one. The tiles
 * fill the width in as many columns as fit; the groups follow each other
 * with their headings, no menu. There is no search of its own here: the
 * search box on https://abap2ui5.github.io/ finds every addon and tool, from
 * the search.json this site publishes. */
import Page from "../layouts/Page.astro";
import Tile from "../components/Tile.astro";
import Search from "../components/Search.astro";
import { groups, orgOf } from "../data/catalog";
import { addon } from "../data/addons";
const base = import.meta.env.BASE_URL;
---
<Page search title="abap2UI5 Addons & Tools" description="Every addon and developer tool of abap2UI5 in one place: what it does, what it needs, how it is installed - selection screens and ALV on ABAP Cloud, RFC and HTTP connectors, Launchpad KPIs, custom controls and more.">

<div class="wrap">
  <div class="hello">
    <div class="hello-text">
      <h1 class="welcome">Addons &amp; Tools</h1>
      <Search />
    </div>
    <img class="hello-logo" src={`${base}addons-logo.svg`} alt="abap2UI5 addons" width="104" height="104">
  </div>

  {groups.map((g) => (
    <section class="group" id={g.id}>
      <h2>{g.title}</h2>
      <ul class="tiles">
        {g.entries.map((e) => <Tile addon={addon(e.repo)} href={e.site ?? `${base}${e.repo}/`} org={orgOf(e)} external={!!e.site} label={e.label} />)}
      </ul>
    </section>
  ))}

  <section class="group join" id="join">
    <h2>Join in</h2>
    <p>All addons are open source and made by the community. Issues, docs and pull requests are welcome in every repository.</p>
    <p>Built something for abap2UI5? Open an issue or a pull request in <a href="https://github.com/abap2UI5-addons/abap2UI5-addons.github.io">this repository</a> and we add it here.</p>
  </section>
</div>

</Page>
