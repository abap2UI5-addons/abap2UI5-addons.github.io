---
/* The document around every page: head, a top line, the foot. The overview
 * and the addon pages share it, so they look alike.
 *
 * THE POLICY. GitHub Pages sets no headers of ours, so the Content-Security-
 * Policy is a <meta>. The page runs no script at all - script-src is 'self',
 * no inline script, no handler attribute - and everything it loads is this
 * origin too. test/site.test.mjs holds every page to it.
 *
 * THE TOP LINE. The one thing this site and the home page share: the
 * wordmark, the two as tabs with the current one marked - here Addons & Tools,
 * which is also the way back from an addon page (CONVENTION.md in
 * abap2UI5/abap2UI5.github.io). The same
 * line as on abap2UI5.github.io. No script anywhere. */
import "../styles/global.css";

interface Props { title: string; description: string; image?: string }
const { title, description, image } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const CSP = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join("; ");
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content={CSP}>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(image ?? `${base}logo.png`, Astro.site).href}>
<meta name="theme-color" content="#ffffff">
<link rel="icon" href={`${base}favicon.png`}>
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
<link rel="preload" href={`${base}fonts/inter-roman-latin.woff2`} as="font" type="font/woff2" crossorigin>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="topline wrap">
  <nav class="sites" aria-label="Sites">
    <a class="brand" href="https://abap2ui5.github.io/">abap2UI5</a>
    <a href="https://abap2ui5.github.io/">Home</a>
    <a href={base} aria-current="page">Addons &amp; Tools</a>
  </nav>
</div>
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap">
    <span>abap2UI5 addons &amp; tools · MIT licensed · <a href="mailto:contact@abap2UI5.org">contact@abap2UI5.org</a> · <a href="https://abap2ui5.github.io/docs/">Documentation</a> · <a href="https://github.com/abap2UI5-addons/abap2UI5-addons.github.io">Edit this site</a></span>
  </div>
</footer>
</body>
</html>
