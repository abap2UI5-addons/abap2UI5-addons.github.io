---
/* The document around every page: head, a top line, the foot. The overview
 * and the add-on pages share it, so they look alike.
 *
 * THE POLICY. GitHub Pages sets no headers of ours, so the Content-Security-
 * Policy is a <meta>. The page runs no script at all - script-src is 'self',
 * no inline script, no handler attribute - and everything it loads is this
 * origin too. test/site.test.mjs holds every page to it.
 *
 * THE TOP LINE. No header, no navigation: a few links on the right - the
 * framework and GitHub, and on an add-on page the way back to the overview.
 * The same line as on abap2UI5.github.io. No script anywhere. */
import "../styles/global.css";

interface Props { title: string; description: string; image?: string; back?: boolean }
const { title, description, image, back = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const CSP = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join("; ");
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content={CSP}>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(image ?? `${base}logo.png`, Astro.site).href}>
<meta name="theme-color" content="#ffffff">
<link rel="icon" href={`${base}favicon.png`}>
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
<link rel="preload" href={`${base}fonts/inter-roman-latin.woff2`} as="font" type="font/woff2" crossorigin>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<p class="topline wrap">{back && <a href={base}>All add-ons</a>}<a href="https://abap2ui5.github.io/">abap2UI5</a><a href="https://github.com/abap2UI5-addons" aria-label="abap2UI5-addons on GitHub" title="GitHub"><svg class="gh" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.2-3.4-1.2-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.2-.4-1.2.1-2.6 0 0 .8-.3 2.8 1a9.4 9.4 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.6.7.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5A10 10 0 0 0 12 2z"/></svg></a></p>
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap">
    <span>abap2UI5 add-ons · MIT licensed · <a href="mailto:contact@abap2UI5.org">contact@abap2UI5.org</a> · <a href="https://abap2ui5.github.io/docs/">Documentation</a> · <a href="https://github.com/abap2UI5-addons/abap2UI5-addons.github.io">Edit this site</a></span>
  </div>
</footer>
</body>
</html>
